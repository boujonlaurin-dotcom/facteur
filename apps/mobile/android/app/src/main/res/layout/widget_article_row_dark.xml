<?xml version="1.0" encoding="utf-8"?>
<!-- Article row — variante SOMBRE. Cf. widget.5 pour la typo (21sp regular).

     Le widget étant un miroir de Flâner, la row est unique : plus d'en-tête
     « 1 — International » ni de badge « À la Une », qui n'existaient que pour
     le bloc Essentiel supprimé (cf. docs/bugs/bug-widget-flaner-android.md).
     Ces vues restaient inflatées et visibles par défaut ; les laisser aurait
     ajouté une ligne vide au-dessus de chaque titre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="21sp"
        android:textColor="@color/facteur_text_primary_dark"
        android:lineSpacingExtra="4dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp">

        <ImageView
            android:id="@+id/row_source_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="7dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Source logo" />

        <TextView
            android:id="@+id/row_source_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textColor="@color/facteur_text_secondary_dark"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/facteur_text_tertiary_dark" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/facteur_border_dark" />
</LinearLayout>
