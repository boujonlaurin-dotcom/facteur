<?xml version="1.0" encoding="utf-8"?>
<!-- Facteur widget — variante CLAIR (parchemin).
     Le clic sur le masthead ouvre le flux dans l'app.
     La liste enchaîne Essentiel (≤5) puis Flux dédupliqués (≤80 total). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_root_bg_light"
    android:padding="16dp">

    <!-- Masthead : pastille F + wordmark "Facteur" — meta (n articles · 7h02) -->
    <LinearLayout
        android:id="@+id/widget_masthead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Marque + wordmark : zone de tap « ouvrir Flâner ». Groupés dans un
             conteneur dédié pour que le 🔄, voisin dans la barre, garde son
             propre clic (un setOnClickPendingIntent sur tout le masthead
             englobait le bouton). -->
        <LinearLayout
            android:id="@+id/masthead_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/masthead_mark"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_facteur_mark_light"
                android:scaleType="fitCenter"
                android:contentDescription="Facteur" />

            <!-- Fraunces Bold : la police de titre du design system
                 (res/font/fraunces_bold.ttf). Un android:textStyle="bold"
                 rendait le wordmark en gras système, hors charte. -->
            <TextView
                android:id="@+id/masthead_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Facteur"
                android:textSize="16sp"
                android:fontFamily="@font/fraunces_bold"
                android:textColor="@color/facteur_text_primary_light" />
        </LinearLayout>

        <!-- Spacer flexible (Space n'est pas RemoteViews-safe sur certains launchers). -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/masthead_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:textColor="@color/facteur_text_tertiary_light"
            android:maxLines="1" />

        <!-- Bouton refresh : rafraîchit le widget **en place** (broadcast vers
             FacteurWidget.onReceive), sans ouvrir l'app. Le padding porte la
             cible de tap à 40dp : à 18dp nus, le doigt tombait régulièrement à
             côté et le bouton passait pour mort. -->
        <ImageView
            android:id="@+id/masthead_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="-8dp"
            android:padding="11dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/facteur_text_tertiary_light"
            android:scaleType="fitCenter"
            android:contentDescription="Rafraîchir" />
    </LinearLayout>

    <!-- Liste scrollable — bound to FacteurWidgetService via setRemoteAdapter. -->
    <ListView
        android:id="@+id/articles_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="@color/facteur_text_secondary_light"
        android:visibility="gone"
        android:text="Ouvre Facteur pour charger ton actualité" />
</LinearLayout>
